# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# IDE files
# The whole directory is ignored: the previously tracked subset still carried
# per-developer paths and JDK names, which produced noise in every review.
*.iml
.idea/

# Signing material. Release signing lands with the release workflow, and a
# keystore committed by accident cannot be un-leaked.
*.jks
*.keystore
keystore.properties
signing.properties

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Compiled class files
*.dex
*.class

# Generated and Output files
bin/
gen/
out/
captures/
.externalNativeBuild/
.cxx/

# OS Specific
.DS_Store
