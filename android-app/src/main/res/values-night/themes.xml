<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark counterpart. Without it the window flashes near-white before Compose
      draws the dark surface, which is the most noticeable on the lock screen
      because that is the first thing a store sees each morning.
    -->
    <style name="Theme.Kaup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
